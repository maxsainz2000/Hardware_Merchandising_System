{
  "type": "object",
  "additionalProperties": false,
  "required": ["scopeId", "status", "summary", "verification"],
  "properties": {
    "scopeId":  { "type": "string" },
    "taskId":   { "type": ["string", "null"] },
    "status":   { "type": "string", "enum": ["done", "partial", "blocked", "failed"] },
    "summary":  { "type": "string", "maxLength": 400 },
    "filesChanged": { "type": "array", "items": { "type": "string" }, "maxItems": 40 },
    "commit":   { "type": ["string", "null"] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guardrails", "tests"],
      "properties": {
        "guardrails": { "type": "string", "enum": ["pass", "fail", "not-run"] },
        "tests":      { "type": "string", "enum": ["pass", "fail", "not-run"] },
        "evidence":   { "type": ["string", "null"] },
        "failureTail":{ "type": ["string", "null"], "maxLength": 800 }
      }
    },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stopCondition", "detail"],
      "properties": {
        "stopCondition": { "type": ["integer", "string"] },
        "detail": { "type": "string", "maxLength": 600 }
      }
    },
    "needsDecision": { "type": ["string", "null"], "maxLength": 600 },
    "scopeCreepRefused": { "type": ["string", "null"], "maxLength": 300 },

    "cards": {
      "type": ["array", "null"],
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id":      { "type": "string", "maxLength": 20 },
          "status":  { "type": "string", "enum": ["done", "partial", "blocked", "failed", "not-started"] },
          "commit":  { "type": ["string", "null"], "maxLength": 60 },
          "tests":   { "type": ["string", "null"], "enum": ["pass", "fail", "not-run", null] },
          "summary": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    },

    "notes": {
      "type": ["array", "null"],
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key":    { "type": "string", "maxLength": 60 },
          "ok":     { "type": ["boolean", "null"] },
          "detail": { "type": ["string", "null"], "maxLength": 600 }
        }
      }
    }
  }
}
