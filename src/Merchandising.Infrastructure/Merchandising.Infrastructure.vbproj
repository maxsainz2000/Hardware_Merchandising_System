<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Merchandising.Infrastructure - MariaDB connection handling, parameterized
    queries, transactions, repositories, audit persistence, configuration.
    Spec section 7.

    SERVER-SIDE ONLY. This project is where the database connector and the
    connection string live (task P1-05). Guardrail G-B fails the build if any
    client project - ClientCommon, Procurement, Inventory, POS - references
    it, because that reference is the mechanism by which a database
    credential would reach a client laptop. See CLAUDE.md section 4.
  -->

  <PropertyGroup>
    <RootNamespace>Merchandising.Infrastructure</RootNamespace>
    <TargetFramework>$(MerchNetTfm)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Merchandising.Domain\Merchandising.Domain.vbproj" />
    <ProjectReference Include="..\Merchandising.Contracts\Merchandising.Contracts.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MariaDB's own documentation recommends MySqlConnector for MariaDB
      Server (spec section 6.3). Version pinned in docs/adr.md ADR-002 -
      task P1-05. Do not bump without updating that ADR entry first
      (CLAUDE.md section 6).
    -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      P1-08 / ADR-005. Gives access to Microsoft.AspNetCore.Identity.
      PasswordHasher(Of TUser) - spec section 9's "framework-provided
      password-hashing implementation" - without a PackageReference or a
      version to pin. FrameworkReference resolves against the SDK/runtime
      already installed (confirmed: Microsoft.Extensions.Identity.Core.dll
      is present under the installed Microsoft.AspNetCore.App 10.0.9 shared
      framework), the same way Merchandising.Api already gets ASP.NET Core
      itself through the Web SDK's implicit framework reference.

      This is also why the opaque session token was chosen over JWT bearer:
      Microsoft.AspNetCore.Authentication.JwtBearer and
      System.IdentityModel.Tokens.Jwt are NOT in that shared framework, so
      that path would have needed new packages with versions not yet
      recorded in docs/adr.md (CLAUDE.md section 6).
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
